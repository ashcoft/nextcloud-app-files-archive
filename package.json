{
  "name": "files-archive",
  "version": "1.3.2",
  "private": true,
  "description": "On-the-fly archive inspector for Nextcloud",
  "homepage": "https://github.com/rotdrop/nextcloud-app-files-archive.git",
  "bugs": {
    "url": "https://github.com/rotdrop/nextcloud-app-files-archive.git"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rotdrop/nextcloud-app-files-archive.git"
  },
  "license": "agpl",
  "author": "Claus-Justus Heine <himself@claus-justus-heine.de>",
  "type": "module",
  "scripts": {
    "build": "vite --mode production build",
    "dev": "vite --mode development build",
    "lint": "eslint --ext .js,.ts,.vue src",
    "lint:fix": "eslint --ext .js,.ts,.vue src --fix",
    "stylelint": "stylelint 'src/**/*.vue' 'src/**/*.css'",
    "stylelint:fix": "stylelint --fix 'src/**/*.vue' 'src/**/*.css'",
    "test:e2e": "playwright test",
    "test:unit": "vitest run",
    "release": "semantic-release"
  },
  "browserslist": [
    "extends @nextcloud/browserslist-config"
  ],
  "devDependencies": {
    "@babel/node": "^7.29.0",
    "@babel/preset-typescript": "^7.28.5",
    "@nextcloud/auth": "^2.6.0",
    "@nextcloud/axios": "^2.6.0",
    "@nextcloud/babel-config": "^1.3.0",
    "@nextcloud/browserslist-config": "^3.1.2",
    "@nextcloud/dialogs": "^7.3.0",
    "@nextcloud/eslint-config": "^9.0.1",
    "@nextcloud/event-bus": "^3.3.3",
    "@nextcloud/files": "^4.1.0-beta.2",
    "@nextcloud/initial-state": "*",
    "@nextcloud/l10n": "*",
    "@nextcloud/router": "^3.1.0",
    "@nextcloud/stylelint-config": "3.2.2",
    "@nextcloud/typings": "^1.10.0",
    "@nextcloud/vite-config": "^3.0.0-beta.1",
    "@nextcloud/vue": "^9.8.0",
    "@playwright/test": "1.64.1",
    "@prettier/plugin-php": "^0.25.0",
    "@rotdrop/nextcloud-vue-components": "file:repositories/rotdrop/nextcloud-vue-components",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "axios": "*",
    "content-disposition": "*",
    "conventional-changelog-conventionalcommits": "^10.4.1",
    "deep-equal": "^2.2.3",
    "esbuild": "^0.28.2",
    "floating-vue": "^5.2.2",
    "is-plain-object": "^5.0.0",
    "js-md5": "^0.8.3",
    "jsdom": "30.1.3",
    "prettier": "^3.9.9",
    "sass": "^1.99.0",
    "semantic-release": "^25.0.9",
    "stacktrace-gps": "github:stacktracejs/stacktrace-gps#62f6967fc85e6fdd5fb9cea1a056b935d9b07a9a",
    "stacktrace-js": "^2.0.2",
    "stylelint": "17.16.0",
    "stylelint-config-recommended-scss": "17.0.1",
    "stylelint-config-recommended-vue": "1.6.1",
    "typescript": "^6.0.3",
    "uuid": "^14.0.0",
    "vite": "^8.3.1",
    "vite-plugin-svgo": "^3.0.1",
    "vitest": "5.0.5",
    "vue": "^3.5.34",
    "vue-material-design-icons": "^5.3.1",
    "xml2js": "*"
  },
  "prettier": {
    "singleQuote": true,
    "tabWidth": 2,
    "useTabs": false,
    "printWidth": 160,
    "importOrderSeparation": true,
    "importOrderSortSpecifiers": true,
    "plugins": [
      "@prettier/plugin-php",
      "@trivago/prettier-plugin-sort-imports"
    ],
    "overrides": [
      {
        "files": "*.php",
        "options": {
          "parser": "php"
        }
      }
    ]
  },
  "engines": {
    "node": "^24.0.0 || >=26.0.0",
    "npm": "^11.0.0"
  },
  "allowScripts": {
    "@parcel/watcher": true,
    "core-js": true,
    "esbuild": true
  }
}
